{
  "name": "radio-planning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"src/**/*.vue\"",
    "lint:vue": "node node_modules/eslint/bin/eslint.js \"src/**/*.vue\"",
    "prepare:assets": "node scripts/prepare-demo-assets.mjs",
    "prepare:sr4-terrain": "node scripts/export-sr4-terrain.mjs",
    "prepare:report-font": "node scripts/prepare-report-font.mjs"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "echarts": "6.1.0",
    "docx": "9.8.1",
    "pdfmake": "0.3.11",
    "exceljs": "4.4.0",
    "papaparse": "5.7.0",
    "ol": "10.10.0",
    "pinia": "3.0.4",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.46.2",
    "@types/node": "24.10.1",
    "@types/pdfmake": "0.3.3",
    "@types/papaparse": "5.5.2",
    "@vitejs/plugin-vue": "6.0.5",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.5.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "vue-tsc": "3.1.8",
    "vue-eslint-parser": "10.2.0"
  },
  "overrides": {
    "@primeuix/styles": "2.0.3",
    "@primeuix/styled": "0.7.4",
    "@primeuix/utils": "0.6.2"
  },
  "engines": { "node": ">=22.12.0" }
}
